{
  "name": "fumi",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Browser encryption and decryption with GitHub public keys, OpenPGP and age.",
  "scripts": {
    "build": "npm run build:client && NEXT_TELEMETRY_DISABLED=1 next build",
    "build:age": "node scripts/build-age.mjs",
    "fixtures": "node scripts/gpg-fixtures.mjs",
    "test": "node --test tests/*.test.mjs",
    "fixtures:signatures": "node scripts/signature-fixtures.mjs",
    "build:client": "node scripts/build.mjs",
    "dev": "npm run build:client && NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3000",
    "test:browser": "node scripts/browser-check.mjs",
    "test:motion": "node scripts/browser-check.mjs motion",
    "test:disclosure": "node scripts/browser-check.mjs disclosure",
    "test:layout": "node scripts/browser-check.mjs layout",
    "test:cli": "node scripts/check-cli-compatibility.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "openpgp": "6.3.2",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryoshin0830/fumi.git"
  }
}
